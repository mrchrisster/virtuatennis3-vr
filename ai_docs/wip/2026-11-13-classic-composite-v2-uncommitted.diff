+/* Virtua Tennis 3 in Classic: the game's screen copies composited back and
+ * the colour clear before them kept, as on the cabinet (2026-11-13). Both
+ * rules below (a copy drawn back left out, the clear before it dropped) are
+ * for the world in VR, where a copy of one eye drawn over both would flatten
+ * it; they also caught Classic's frames once every Classic frame became flat
+ * (7675d88 flat menus, later every frame), so Classic lost its depth-of-field
+ * and glare composite: the far crowd, the far wall's top edge and other fine
+ * detail at the top of the picture were shown unblurred, aliased, and
+ * sparkled from frame to frame (the owner's "texture flicker"; A-B-A heat
+ * maps in ai_docs). In Classic both layers carry the same flat picture, so
+ * the arcade's own sequence is right. Split screen needs no pane prelude
+ * then (its colour clear is the game's own). LINDBERGH_CLASSIC_COMPOSITE=0:
+ * left out as before. */
+static int classic_composite(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char *v = getenv("LINDBERGH_CLASSIC_COMPOSITE"), *fa = getenv("LINDBERGH_FLAT_ALL");
+        on = v && *v ? atoi(v) : 1;     /* 1: the composite draws kept; 2: the colour clears before them kept too */
+        if (!world_mode_capable() || world_mode_immersive() || (fa && *fa == '0')) on = 0;
+        fprintf(stderr, "[stereo] Classic: the game's screen copies composited back (depth of field, glare): %s\n",
+                on == 2 ? "yes, with the colour clears" : on ? "yes (the colour clears still left out)" : "no (LINDBERGH_CLASSIC_COMPOSITE=0 or not Classic)");
+    }
+    static long at = -2;    /* LINDBERGH_CLASSIC_COMPOSITE_AT=<frame>: off before that frame, on from it (tests: before / after in one run) */
+    if (at == -2) { const char *v = getenv("LINDBERGH_CLASSIC_COMPOSITE_AT"); at = v && *v ? atol(v) : -1; }
+    return on && g_flat && (at < 0 || (long)g_frame >= at) ? on : 0;
+}
