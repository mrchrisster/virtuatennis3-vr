+    if (g_on && g_mv && !g_side && (is_draw(k) || k == K_BEGIN) && g_tex2d_on && g_nscreen_copy && screen_copy(g_tex2d_bound) && (g_scene_draws || (g_flat && g_eye_draws)) && !classic_composite()) {
